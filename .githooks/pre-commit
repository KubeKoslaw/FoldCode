#!/usr/bin/env bash
# Blocks commits that would publish private data: private keys, LAN addresses, local home paths,
# personal mail addresses, device serials, or anything from the git-ignored key/output folders.
set -euo pipefail

fail=0
added="$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep -E '^\+[^+]' || true)"

check() { # check <description> <extended regex>
    local hits
    hits="$(printf '%s\n' "$added" | grep -n -E "$2" || true)"
    if [ -n "$hits" ]; then
        echo "pre-commit: blocked — $1:" >&2
        printf '%s\n' "$hits" | head -n 5 >&2
        fail=1
    fi
}

check "private key material" 'BEGIN [A-Z ]*PRIVATE KEY'
check "LAN IP address" '\b(192\.168|10\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\b'
check "local home path" '/home/[a-z_][a-z0-9_-]*/'
check "personal e-mail address" '[A-Za-z0-9._%+-]+@(gmail|googlemail|outlook|hotmail|yahoo|wp|o2|onet|interia)\.[a-z.]+'
check "GitHub token" '(ghp|gho|ghs|ghu|github_pat)_[A-Za-z0-9_]{20,}'

if git diff --cached --name-only | grep -E '^(keys|out|third_party)/|\.keystore$|local\.properties$' >/dev/null; then
    echo "pre-commit: blocked — files from keys/, out/, third_party/ or local config are staged" >&2
    fail=1
fi

while IFS= read -r f; do
    [ -f "$f" ] || continue
    if [ "$(wc -c < "$f")" -gt 5000000 ]; then
        echo "pre-commit: blocked — $f is larger than 5 MB" >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

exit $fail
